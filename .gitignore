# Compiled binaries. The server is `theia-server` from V3.3 (decision 119); the
# old names stay listed because a transitional build, a rollback and the
# end-to-end verifier all still produce them.
/theia
/theia.exe
/theia-server
/theia-server.exe
/dist/
*.exe
*.test
*.out
# Windows cannot overwrite a running executable, so go build renames the old one
# out of the way instead of replacing it.
*.exe~

# Frontend build output. Generated by `npm run build` in web/ and embedded into
# the binary at compile time, so it is never committed -- but the directory must
# exist for //go:embed to resolve, hence the tracked .gitkeep.
/web-dist/*
!/web-dist/.gitkeep

# Node
node_modules/
web/.svelte-kit/
web/build/

# Rust and the native player.
#
# A Tauri debug build is measured in gigabytes and belongs to the machine that
# made it. The release bundle is produced in CI from a clean tree, so none of it
# is committed. Cargo.lock is deliberately *not* ignored: this is a binary, and
# the lockfile is what makes a build reproducible.
/player/target/
/player/theia-player/gen/

# The OSD bundle. tauri-build embeds it, so it has to exist before `cargo
# build` -- but it is generated, by `npm install && npm run build` in player/ui/.
# The player's README states that order.
/player/ui/dist/

# What the OSD render check draws. Pictures of a run, not sources: they belong
# to the run that produced them, exactly like the browser guard's traces.
/player/ui/render-check/

# Local runtime data
*.db
*.db-shm
*.db-wal
.env
.env.*

# Local development overrides. These hold real credentials -- the TMDB key
# above all -- and this repository is public. Never remove these lines, and
# never commit a file matching them.
config.local.json
*.local.json
*.local.yaml
secrets/

# OS noise
.DS_Store
Thumbs.db

# Playwright's own output. The guard writes traces and screenshots only when
# something fails, and those belong to the run that produced them.
web/test-results/
web/playwright-report/

# Launch drafts -- r/selfhosted post, awesome-selfhosted entry. They carry
# posting strategy the maintainer decided should stay off a public repository,
# not just unpublished content within it.
/docs/outreach/
