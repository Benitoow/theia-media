# Compiled binaries
/theia
/theia.exe
/dist/
*.exe
*.test
*.out
# Windows cannot overwrite a running executable, so go build renames the old one
# out of the way instead of replacing it.
*.exe~

# Frontend build output. Generated by `npm run build` in web/ and embedded into
# the binary at compile time, so it is never committed -- but the directory must
# exist for //go:embed to resolve, hence the tracked .gitkeep.
/web-dist/*
!/web-dist/.gitkeep

# Node
node_modules/
web/.svelte-kit/
web/build/

# Local runtime data
*.db
*.db-shm
*.db-wal
.env
.env.*

# Local development overrides. These hold real credentials -- the TMDB key
# above all -- and this repository is public. Never remove these lines, and
# never commit a file matching them.
config.local.json
*.local.json
*.local.yaml
secrets/

# Generated by site/build.mjs, published by .github/workflows/pages.yml
site/dist/

# OS noise
.DS_Store
Thumbs.db

# Work from other projects that ended up in this checkout.
#
# An Android debloat script and a set of Xiaomi wallpaper APKs, around 750 MB of
# them, were sitting untracked in the working tree. Nothing here belongs to
# Theia and none of it is licence-checked, which matters because this repository
# is public and GPL-3.0: one `git add -A` was the whole distance between a
# stray APK and a published one.
#
# They are ignored rather than deleted -- they are somebody's work, and moving
# them somewhere sensible is a decision for whoever made them.
/.superwallpaper-tools/
/superwallpapers/
/debloat-log.txt
/wallpapers-log.txt
/packages-*.txt
/restore.sh

# Throwaway parser spike from M3. Empty, and kept out so it stays that way.
/spike-m3-parser/

# Playwright's own output. The guard writes traces and screenshots only when
# something fails, and those belong to the run that produced them.
web/test-results/
web/playwright-report/
