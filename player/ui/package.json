{
	"name": "theia-player-osd",
	"private": true,
	"version": "0.3.3",
	"type": "module",
	"description": "Theia's native desktop player, built with React, TypeScript, Tailwind and shadcn/ui.",
	"scripts": {
		"dev": "vite",
		"check:i18n": "node scripts/check-locales.mjs",
		"check:types": "tsc --noEmit",
		"check:render": "node scripts/render-check.mjs",
		"prebuild": "npm run check:i18n && npm run check:types",
		"build": "vite build",
		"preview": "vite preview"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.3.7",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.468.0",
		"motion": "^12.23.24",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-router-dom": "^7.18.4",
		"tailwind-merge": "^3.4.0"
	},
	"devDependencies": {
		"@fontsource-variable/cinzel": "^5.3.0",
		"@fontsource-variable/jost": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"@vitejs/plugin-react": "^5.1.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^6.4.3"
	}
}
