{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Theia",
  "version": "3.3.3",
  "identifier": "media.theia.player",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Theia",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 360,
        "transparent": true,
        "decorations": false,
        "resizable": true,
        "shadow": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
