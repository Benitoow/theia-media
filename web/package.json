{
	"name": "theia-web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"check:i18n": "node scripts/check-locales.mjs",
		"check:backdrops": "node scripts/check-backdrops.mjs",
		"prebuild": "npm run check:i18n && npm run check:backdrops",
		"build": "vite build",
		"postbuild": "node scripts/keep-webdist.mjs",
		"preview": "vite preview",
		"test": "playwright test",
		"test:unit": "node --test \"tests/unit/*.test.js\"",
		"test:ui": "playwright test --ui"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.20.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/vite": "^4.0.0",
		"svelte": "^5.20.0",
		"tailwindcss": "^4.0.0",
		"vite": "^6.0.0"
	},
	"dependencies": {
		"@fontsource-variable/cinzel": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jost": "^5.3.0",
		"@fontsource-variable/playfair-display": "^5.3.0"
	}
}
