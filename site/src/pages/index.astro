---
// The public presentation page. Static sections render at build; the two
// interactive components (download station, player chrome) are React islands
// hydrated only when they approach the viewport. The page performs no runtime
// API call: every fact is a build-time fact.
import '@/styles/global.css';
import copy, { REPO, SITE, DISCORD, PLATFORMS } from '@/lib/copy';
import { loadRelease } from '@/lib/release';
import DownloadStation from '@/components/DownloadStation';
import PlayerDemo from '@/components/PlayerDemo';

const release = await loadRelease();
const releaseUrl = release.url || `${REPO}/releases/latest`;

// The site is published under a repository subpath; BASE carries it so every
// public asset reference stays correct locally, in previews and on Pages.
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

// Font faces are declared in the head rather than the bundled stylesheet:
// a url() there cannot be templated, and this one must carry the base path.
const fontFaces = `
@font-face {
	font-family: 'Playfair Display Variable';
	font-style: normal;
	font-display: swap;
	font-weight: 400 900;
	src: url('${base}fonts/playfair-display.woff2') format('woff2-variations');
}
@font-face {
	font-family: 'Inter Variable';
	font-style: normal;
	font-display: swap;
	font-weight: 100 900;
	src: url('${base}fonts/inter.woff2') format('woff2-variations');
}
`;

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'SoftwareApplication',
			name: 'Theia',
			url: copy.canonical,
			applicationCategory: 'MultimediaApplication',
			operatingSystem: 'Windows, macOS, Linux',
			softwareVersion: release.version || undefined,
			datePublished: release.publishedAt || undefined,
			license: 'https://www.gnu.org/licenses/gpl-3.0.html',
			downloadUrl: `${REPO}/releases/latest`,
			description: copy.meta.description
		},
		{
			'@type': 'FAQPage',
			mainEntity: copy.faq.items.map(([question, answer]) => ({
				'@type': 'Question',
				name: question,
				acceptedAnswer: { '@type': 'Answer', text: answer }
			}))
		}
	]
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#0b0a09" />
		<title>{copy.meta.title}</title>
		<meta name="description" content={copy.meta.description} />
		<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
		<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
		<link rel="canonical" href={`${copy.canonical}/`} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Theia" />
		<meta property="og:url" content={`${copy.canonical}/`} />
		<meta property="og:locale" content={copy.ogLocale} />
		<meta property="og:title" content={copy.meta.title} />
		<meta property="og:description" content={copy.meta.description} />
		<meta property="og:image" content={`${SITE}/social-preview.png`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={copy.meta.ogAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={copy.meta.title} />
		<meta name="twitter:description" content={copy.meta.description} />
		<meta name="twitter:image" content={`${SITE}/social-preview.png`} />
		<link rel="preload" href={`${base}fonts/playfair-display.woff2`} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={`${base}fonts/inter.woff2`} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={`${base}shots/player.webp`} as="image" type="image/webp" fetchpriority="high" />
		<style is:inline set:html={fontFaces} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
	</head>
	<body>
		<a
			class="fixed top-0 -left-[9999px] z-[100] py-3 px-4 bg-bone text-ink focus:top-3 focus:left-3"
			href="#content"
		>
			{copy.skip}
		</a>

		<header class="sticky top-0 z-30 border-b border-line bg-ink/92 backdrop-blur-[14px]">
			<nav class="shell flex min-h-[4.5rem] items-center justify-between gap-4" aria-label={copy.nav.label}>
				<a class="flex min-h-[44px] min-w-[7.5rem] items-center font-display text-[1.08rem] leading-none tracking-[var(--tracking-label)] max-[43.75rem]:min-h-[4rem]" href="#content">
					THEIA<span aria-hidden="true" class="ml-2.5 h-px w-10 bg-gradient-to-r from-accent to-transparent"></span>
				</a>
				<div class="flex items-center gap-[clamp(0.35rem,2vw,1.5rem)]">
					<a class="nav-link hidden min-[43.75rem]:inline-flex" href="#how">{copy.nav.how}</a>
					<a class="nav-link hidden min-[43.75rem]:inline-flex" href="#moments">{copy.nav.moments}</a>
					<a class="nav-link hidden min-[43.75rem]:inline-flex" href="#difference">{copy.nav.difference}</a>
					<a
						class="inline-flex min-h-[44px] items-center rounded-full border border-line px-4 text-sm font-semibold text-bone transition-colors hover:border-faint hover:bg-raised max-[24.375rem]:text-[0.8125rem]"
						href="#download"
					>
						{copy.nav.download}
					</a>
				</div>
			</nav>
		</header>

		<main id="content" tabindex="-1" class="outline-none">
			<!-- The promise. Proof and download follow before anything else. -->
			<section class="shell relative">
				<div
					aria-hidden="true"
					class="pointer-events-none absolute -top-32 left-[10%] h-[30rem] w-[44rem] max-w-full rounded-full opacity-[0.16] [background:radial-gradient(closest-side,var(--color-accent),transparent)]"
				>
				</div>
				<div class="relative pt-[clamp(3.5rem,8vw,7.5rem)] pb-[clamp(2.5rem,5vw,4rem)]">
					<p class="eyebrow rise">{copy.hero.eyebrow}</p>
					<h1
						class="m-0 max-w-[10ch] font-display font-normal leading-[0.9] tracking-[var(--tracking-hero)] text-[clamp(3.15rem,5.4vw,6.25rem)] max-[24.375rem]:text-[clamp(3rem,14vw,5rem)]"
					>
						<span class="rise inline-block" style="animation-delay:80ms">{copy.hero.titleLead}</span>
						<br />
						<span class="rise text-gild inline-block" style="animation-delay:180ms">{copy.hero.titleRest}</span>
					</h1>
					<p class="rise mt-6 max-w-[54ch] text-[clamp(1.02rem,1.45vw,1.24rem)] leading-relaxed text-bone" style="animation-delay:300ms">
						{copy.hero.lead}
					</p>
					<div class="rise mt-8 flex flex-wrap items-center gap-3" style="animation-delay:420ms">
						<a class="btn btn-primary" href="#download">
							{copy.hero.primary}
							<span aria-hidden="true">↓</span>
						</a>
						<a class="btn btn-secondary" href="#how">{copy.hero.secondary}</a>
					</div>
				</div>
				<ul class="rise relative m-0 flex list-none flex-wrap gap-y-1 border-t border-line p-0" style="animation-delay:540ms">
					{
						copy.hero.facts.map((fact) => (
							<li class="flex min-w-[50%] min-[43.75rem]:min-w-0 min-[43.75rem]:flex-1 items-center gap-2.5 border-l border-line py-4 pl-4 first:border-l-0 first:pl-0 max-[43.75rem]:[&:nth-child(2n)]:border-l-0 max-[43.75rem]:[&:nth-child(2n)]:pl-0">
								<span aria-hidden="true" class="h-1 w-1 rounded-full bg-faint" />
								<span class="text-sm font-semibold text-bone">{fact}</span>
							</li>
						))
					}
				</ul>
			</section>

			<!-- How it works: the three steps, in the visitor's own terminal. -->
			<section id="how" class="border-y border-line bg-surface">
				<div class="shell py-[clamp(3.5rem,7vw,6.5rem)]">
					<div class="grid min-[68.75rem]:grid-cols-[0.8fr_1.2fr] items-end gap-8 max-[68.75rem]:grid-cols-1">
						<div>
							<p class="eyebrow">{copy.steps.eyebrow}</p>
							<h2 class="m-0 font-display font-normal leading-[0.98] tracking-[var(--tracking-display)] text-display">
								{copy.steps.title}
							</h2>
						</div>
						<p class="m-0 text-muted max-w-[48ch] max-[68.75rem]:max-w-none">{copy.steps.lead}</p>
					</div>
					<ol class="m-0 grid list-none grid-cols-1 min-[68.75rem]:grid-cols-3 gap-4 p-0 mt-10">
						{
							copy.steps.items.map((step) => (
								<li class="term enter">
									<div class="term-bar">
										<span class="term-dot" aria-hidden="true" />
										<span class="term-dot" aria-hidden="true" />
										<span class="term-dot" aria-hidden="true" />
										<span class="ml-1 font-mono text-[0.6875rem] text-faint">{step.hint}</span>
									</div>
									<div class="p-6">
										<span class="font-mono text-[0.6875rem] tracking-[var(--tracking-label)] text-muted">
											{step.number}
										</span>
										<h3 class="mt-2 font-display font-normal text-[clamp(1.4rem,2vw,1.75rem)] leading-[1.1] tracking-[var(--tracking-title)]">
											{step.title}
										</h3>
										<p class="mt-2.5 mb-0 text-sm text-muted leading-relaxed">{step.body}</p>
										<p class="mt-5 mb-0 flex items-center gap-2 border-t border-line pt-4 font-mono text-[0.8125rem]">
											{step.prompt ? <span aria-hidden="true" class="text-accent">$</span> : <span aria-hidden="true" class="text-faint">→</span>}
											<span class="text-bone">{step.hint}</span>
										</p>
									</div>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<!-- The proof: a real capture, demonstration controls. -->
			<section id="proof" class="shell pt-[clamp(3rem,6vw,5.5rem)]">
				<figure class="m-0">
					<PlayerDemo client:visible t={copy.playerDemo} shot={`${base}shots/player.webp`} />
					<figcaption class="mt-2.5 text-sm text-muted">{copy.playerDemo.caption}</figcaption>
				</figure>
				<noscript>
					<p class="mt-0 text-sm text-muted">{copy.playerDemo.noJs}</p>
				</noscript>
			</section>

			<!-- The download station: system, then architecture. -->
			<section id="download" class="shell mt-[clamp(3rem,6vw,5.5rem)] border-t border-line pt-[clamp(2rem,4vw,3.5rem)] pb-[clamp(3.5rem,7vw,6rem)]">
				<DownloadStation
					client:visible
					t={copy.downloads}
					platforms={PLATFORMS}
					release={release}
					releaseUrl={releaseUrl}
				/>
				<noscript>
					<p class="mt-4 text-sm text-muted">{copy.downloads.noJs}</p>
				</noscript>
			</section>

			<!-- Three moments, not an inventory. -->
			<section id="moments" class="border-y border-line bg-surface">
				<div class="shell py-[clamp(4rem,8vw,7rem)]">
					<header class="mb-[clamp(2.25rem,5vw,4rem)]">
						<p class="eyebrow">{copy.moments.eyebrow}</p>
						<h2 class="m-0 font-display font-normal leading-[0.98] tracking-[var(--tracking-display)] text-display">
							{copy.moments.title}
						</h2>
					</header>
					<ol class="m-0 list-none p-0">
						{
							copy.moments.items.map((moment, index) => (
								<li class="enter grid grid-cols-[5rem_minmax(0,0.9fr)_minmax(19rem,1.1fr)] items-center gap-[clamp(1rem,3vw,3rem)] border-t border-line py-[clamp(2rem,4vw,3.5rem)] max-[68.75rem]:grid-cols-[4rem_minmax(0,1fr)] max-[24.375rem]:grid-cols-1">
									<span class="self-start font-mono text-[0.6875rem] tracking-[var(--tracking-label)] text-muted max-[24.375rem]:mb-[-0.4rem]">
										{String(index + 1).padStart(2, '0')}
									</span>
									<div class="max-[24.375rem]:col-span-1">
										<b class="font-semibold text-[0.6875rem] leading-[1.2] tracking-[var(--tracking-label)] text-muted uppercase">
											{moment.label}
										</b>
										<h3 class="mt-2 mb-2 font-display font-normal leading-[1.05] text-[clamp(1.75rem,3.4vw,3.1rem)]">
											{moment.title}
										</h3>
										<p class="m-0 text-muted">{moment.body}</p>
									</div>
									{moment.shot ? (
										<figure class="spotlight relative m-0 overflow-hidden rounded-[var(--radius-card)] border border-line bg-raised max-[68.75rem]:col-start-2 max-[24.375rem]:col-start-1 max-[24.375rem]:col-end-2 max-[24.375rem]:row-start-2">
											<img
												src={`${base}shots/${moment.shot}`}
												alt={moment.alt}
												width="1600"
												height="900"
												loading="lazy"
												decoding="async"
												class="w-full aspect-video object-cover"
											/>
											{moment.facts && (
												<div
													role="group"
													aria-label={copy.playerDemo.tracksTitle}
													class="absolute bottom-3 left-3 right-3 grid gap-px overflow-hidden rounded-lg border border-line"
												>
													{copy.moments.watchFacts.map(([label, value]) => (
														<div class="grid grid-cols-[0.65fr_1fr] min-h-[40px] items-center gap-4 bg-ink/90 px-4 py-2 backdrop-blur-sm">
															<span class="text-[0.8125rem] text-muted">{label}</span>
															<strong class="text-[0.8125rem] font-semibold leading-[1.3]">{value}</strong>
														</div>
													))}
												</div>
											)}
										</figure>
									) : (
										<figure class="spotlight relative m-0 overflow-hidden rounded-[var(--radius-card)] border border-line bg-raised max-[68.75rem]:col-start-2 max-[24.375rem]:col-start-1 max-[24.375rem]:col-end-2 max-[24.375rem]:row-start-2">
											<img
												src={`${base}shots/${moment.shot}`}
												alt={moment.alt}
												width="1600"
												height="900"
												loading="lazy"
												decoding="async"
												class="w-full aspect-video object-cover"
											/>
											<div
												role="group"
												aria-label={copy.playerDemo.tracksTitle}
												class="absolute bottom-3 left-3 right-3 grid gap-px overflow-hidden rounded-lg border border-line"
											>
												{copy.moments.watchFacts.map(([label, value]) => (
													<div class="grid grid-cols-[0.65fr_1fr] min-h-[40px] items-center gap-4 bg-ink/90 px-4 py-2">
														<span class="text-[0.8125rem] text-muted">{label}</span>
														<strong class="text-[0.8125rem] font-semibold leading-[1.3]">{value}</strong>
													</div>
												))}
											</div>
										</figure>
									)}
								</li>
							))
						}
					</ol>
					<div class="mt-[clamp(2rem,4vw,3.5rem)] border-t border-line pt-[clamp(2rem,4vw,3.5rem)]">
						<p class="eyebrow">{copy.stills.eyebrow}</p>
						<div class="mt-5 grid grid-cols-1 gap-3 min-[43.75rem]:grid-cols-3 min-[68.75rem]:grid-cols-5">
							{
								copy.stills.items.map((still) => (
									<figure class="spotlight m-0 overflow-hidden rounded-xl border border-line bg-raised transition-transform duration-[var(--duration-base)] ease-[var(--ease-cine)] hover:-translate-y-1">
										<img
											src={`${base}shots/${still.file}`}
											alt={still.alt}
											width="1600"
											height="900"
											loading="lazy"
											decoding="async"
											class="w-full aspect-video object-cover"
										/>
									</figure>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<!-- The honest ledger. Limits come before the final invitation. -->
			<section id="difference" class="shell py-[clamp(4rem,7vw,6.5rem)]">
				<div class="grid min-[68.75rem]:grid-cols-[0.8fr_1.2fr] gap-[clamp(2rem,6vw,7rem)] max-[68.75rem]:grid-cols-1">
					<div class="self-start min-[68.75rem]:sticky min-[68.75rem]:top-[7rem]">
						<p class="eyebrow">{copy.difference.eyebrow}</p>
						<h2 class="m-0 font-display font-normal leading-[0.98] tracking-[var(--tracking-display)] text-display">
							{copy.difference.title}
						</h2>
					</div>
					<div>
						<div class="grid grid-cols-1 min-[43.75rem]:grid-cols-2 gap-8">
							<div>
								<h3 class="m-0 font-semibold text-[0.6875rem] leading-[1.2] tracking-[var(--tracking-label)] text-muted uppercase">
									{copy.difference.gainsTitle}
								</h3>
								<ul class="m-0 mt-4 grid list-none gap-3 p-0">
									{
										copy.difference.gains.map(([title, body]) => (
											<li class="rounded-xl border border-line bg-surface p-5">
												<strong class="mb-1 block font-semibold">{title}</strong>
												<span class="block text-sm text-muted leading-relaxed">{body}</span>
											</li>
										))
									}
								</ul>
							</div>
							<div>
								<h3 class="m-0 font-semibold text-[0.6875rem] leading-[1.2] tracking-[var(--tracking-label)] text-muted uppercase">
									{copy.difference.givesTitle}
								</h3>
								<ul class="m-0 mt-4 grid list-none gap-3 p-0">
									{
										copy.difference.gives.map(([title, body]) => (
											<li class="rounded-xl border border-dashed border-line bg-transparent p-5">
												<strong class="mb-1 block font-semibold text-parchment">{title}</strong>
												<span class="block text-sm text-muted leading-relaxed">{body}</span>
											</li>
										))
									}
								</ul>
							</div>
						</div>
						<article class="mt-8 border-t border-line pt-8">
							<h3 class="m-0 font-display font-normal leading-[1.05] text-[clamp(1.5rem,2.5vw,2.3rem)]">
								{copy.difference.safetyTitle}
							</h3>
							<p class="mb-0 mt-3 max-w-[64ch] text-muted">{copy.difference.safetyBody}</p>
							<a class="link-quiet mt-4 text-sm font-semibold" href={`${REPO}#readme`}>
								{copy.difference.compare} <span aria-hidden="true">↗</span>
							</a>
						</article>
					</div>
				</div>
			</section>

			<section class="border-t border-line">
				<div class="shell grid min-[68.75rem]:grid-cols-[1fr_auto] items-end gap-8 py-[clamp(4rem,8vw,7rem)] max-[68.75rem]:grid-cols-1">
					<div>
						<p class="eyebrow">{copy.closing.eyebrow}</p>
						<h2 class="m-0 max-w-[9ch] font-display font-normal leading-[0.92] tracking-[var(--tracking-hero)] text-[clamp(2.8rem,7vw,6.5rem)] max-[24.375rem]:text-[clamp(3rem,14vw,5rem)]">
							{copy.closing.title}
						</h2>
					</div>
					<a class="btn btn-secondary justify-self-start min-[68.75rem]:justify-self-end" href="#download">
						{copy.closing.cta}
						<span aria-hidden="true">↑</span>
					</a>
				</div>
			</section>

			<section class="border-t border-line">
				<div class="shell grid min-[68.75rem]:grid-cols-[0.65fr_1.35fr] gap-[clamp(2rem,6vw,7rem)] py-[clamp(3.5rem,7vw,6rem)] max-[68.75rem]:grid-cols-1">
					<header>
						<p class="eyebrow">{copy.faq.eyebrow}</p>
						<h2 class="m-0 font-display font-normal leading-[0.98] tracking-[var(--tracking-display)] text-display">
							{copy.faq.title}
						</h2>
					</header>
					<div>
						{
							copy.faq.items.map(([question, answer]) => (
								<details data-faq class="border-t border-line last:border-b group">
									<summary class="flex min-h-[64px] cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
										{question}
										<span aria-hidden="true" class="font-mono text-[1.3rem] leading-none text-muted group-open:hidden">
											+
										</span>
										<span aria-hidden="true" class="hidden font-mono text-[1.3rem] leading-none text-muted group-open:inline">
											−
										</span>
									</summary>
									<p class="m-0 mb-6 max-w-[62ch] text-muted">{answer}</p>
								</details>
							))
						}
					</div>
				</div>
			</section>
		</main>

		<footer class="border-t border-line py-8 text-sm text-muted">
			<div class="shell grid min-[43.75rem]:grid-cols-[1fr_auto] items-start gap-8 max-[43.75rem]:grid-cols-1">
				<div>
					<p class="m-0 mb-2">{copy.footer.body}</p>
					<p class="m-0">{copy.footer.tmdb}</p>
				</div>
				<nav class="flex flex-wrap gap-4" aria-label={copy.footer.navLabel}>
					<a class="link-quiet text-bone" href={REPO}>
						{copy.footer.source} <span aria-hidden="true">↗</span>
					</a>
					<a class="link-quiet text-bone" href={`${REPO}/blob/main/LICENSE`}>
						{copy.footer.license} <span aria-hidden="true">↗</span>
					</a>
					<a class="link-quiet text-bone" href={DISCORD}>
						Discord <span aria-hidden="true">↗</span>
					</a>
				</nav>
			</div>
		</footer>

		<!-- One delegated listener for every spotlight card on the page. -->
		<script is:inline>
			document.addEventListener(
				'pointermove',
				function (event) {
					var target = event.target;
					if (!(target instanceof Element)) return;
					var card = target.closest('.spotlight');
					if (!card) return;
					var rect = card.getBoundingClientRect();
					card.style.setProperty('--spot-x', ((event.clientX - rect.left) / rect.width) * 100 + '%');
					card.style.setProperty('--spot-y', ((event.clientY - rect.top) / rect.height) * 100 + '%');
				},
				{ passive: true }
			);
